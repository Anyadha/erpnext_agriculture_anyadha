 "doctype": "Print Format",
 "font_size": 10,
 "html": "<div class=\"print-format\">\n<style>\n.print-format {\n    font-family: Arial, sans-serif;\n    padding: 20px;\n}\n.header {\n    text-align: center;\n    border-bottom: 2px solid #333;\n    padding-bottom: 10px;\n    margin-bottom: 20px;\n}\n.header h2 {\n    margin: 0;\n    color: #2E7D32;\n}\n.section {\n    margin-bottom: 15px;\n}\n.row {\n    display: flex;\n    margin-bottom: 8px;\n}\n.label {\n    font-weight: bold;\n    width: 200px;\n    color: #555;\n}\n.value {\n    flex: 1;\n}\n.table-section {\n    margin-top: 20px;\n}\ntable {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 10px;\n}\ntable th {\n    background-color: #2E7D32;\n    color: white;\n    padding: 10px;\n    text-align: left;\n}\ntable td {\n    padding: 8px;\n    border-bottom: 1px solid #ddd;\n}\n.footer {\n    margin-top: 40px;\n    border-top: 2px solid #333;\n    padding-top: 10px;\n}\n.signature {\n    display: flex;\n    justify-content: space-between;\n    margin-top: 60px;\n}\n.signature-box {\n    text-align: center;\n    width: 200px;\n}\n.signature-line {\n    border-top: 1px solid #333;\n    margin-top: 40px;\n    padding-top: 5px;\n}\n.brand-line {\n    margin-top: 12px;\n    font-size: 9px;\n    color: #666;\n}\n</style>\n\n<div class=\"header\">\n    <h2>HARVEST RECEIPT</h2>\n    <p style=\"margin: 6px 0 0; color: #555;\">Umaish Solutions | 2026 Edition</p>\n    <p>{{ doc.name }}</p>\n</div>\n\n<div class=\"section\">\n    <div class=\"row\">\n        <span class=\"label\">Harvest Date:</span>\n        <span class=\"value\">{{ frappe.utils.formatdate(doc.harvest_date, \"dd-MM-yyyy\") }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Farm:</span>\n        <span class=\"value\">{{ doc.farm }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Field:</span>\n        <span class=\"value\">{{ doc.field }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Crop Project:</span>\n        <span class=\"value\">{{ doc.crop_project }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Crop:</span>\n        <span class=\"value\">{{ doc.crop_item }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Area Harvested:</span>\n        <span class=\"value\">{{ doc.area_harvested }} {{ doc.area_uom }}</span>\n    </div>\n</div>\n\n<div class=\"section\">\n    <h3>Harvest Summary</h3>\n    <div class=\"row\">\n        <span class=\"label\">Total Quantity Harvested:</span>\n        <span class=\"value\"><strong>{{ doc.quantity_harvested }} {{ doc.harvest_uom }}</strong></span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Yield per {{ doc.area_uom }}:</span>\n        <span class=\"value\">{{ doc.yield_per_unit_area }} {{ doc.harvest_uom }}/{{ doc.area_uom }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Batch Number:</span>\n        <span class=\"value\">{{ doc.batch_no or \"To be assigned\" }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Target Warehouse:</span>\n        <span class=\"value\">{{ doc.target_warehouse }}</span>\n    </div>\n</div>\n\n{% if doc.grade_distribution %}\n<div class=\"table-section\">\n    <h3>Quality Grade Distribution</h3>\n    <table>\n        <thead>\n            <tr>\n                <th>Grade</th>\n                <th>Quantity</th>\n                <th>Percentage</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.grade_distribution %}\n            <tr>\n                <td>{{ row.grade }}</td>\n                <td>{{ row.quantity }} {{ doc.harvest_uom }}</td>\n                <td>{{ \"%.2f\"|format(row.percentage) }}%</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n</div>\n{% endif %}\n\n{% if doc.harvest_team %}\n<div class=\"table-section\">\n    <h3>Harvest Team</h3>\n    <table>\n        <thead>\n            <tr>\n                <th>Employee</th>\n                <th>Hours</th>\n                <th>Rate</th>\n                <th>Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.harvest_team %}\n            <tr>\n                <td>{{ row.employee }} - {{ row.employee_name }}</td>\n                <td>{{ row.hours }}</td>\n                <td>{{ frappe.utils.fmt_money(row.rate, currency=frappe.defaults.get_global_default('currency')) }}</td>\n                <td>{{ frappe.utils.fmt_money(row.amount, currency=frappe.defaults.get_global_default('currency')) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n</div>\n{% endif %}\n\n<div class=\"footer\">\n    <div class=\"row\">\n        <span class=\"label\">Recorded By:</span>\n        <span class=\"value\">{{ doc.owner }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Date & Time:</span>\n        <span class=\"value\">{{ frappe.utils.format_datetime(doc.creation, \"dd-MM-yyyy HH:mm\") }}</span>\n    </div>\n\n    <div class=\"signature\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Farm Manager</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Quality Inspector</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Warehouse Keeper</div>\n        </div>\n    </div>\n\n    <div class=\"brand-line\">Umaish Solutions Agriculture 2026</div>\n</div>\n\n</div>",
 "idx": 0,
 "line_breaks": 0,
