 "font_size": 10,
 "html": "<div class=\"batch-label\">\n<style>\n.batch-label {\n    width: 10cm;\n    height: 7cm;\n    padding: 10px;\n    font-family: Arial, sans-serif;\n    border: 2px solid #333;\n    position: relative;\n}\n.label-header {\n    text-align: center;\n    border-bottom: 2px solid #2E7D32;\n    padding-bottom: 5px;\n    margin-bottom: 10px;\n}\n.label-header h3 {\n    margin: 0;\n    color: #2E7D32;\n    font-size: 16px;\n}\n.batch-number {\n    text-align: center;\n    font-size: 24px;\n    font-weight: bold;\n    margin: 10px 0;\n    color: #333;\n}\n.info-row {\n    display: flex;\n    margin-bottom: 6px;\n    font-size: 11px;\n}\n.info-label {\n    font-weight: bold;\n    width: 100px;\n    color: #555;\n}\n.info-value {\n    flex: 1;\n}\n.qr-section {\n    position: absolute;\n    bottom: 10px;\n    right: 10px;\n    width: 80px;\n    height: 80px;\n    border: 1px solid #ddd;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 8px;\n    color: #999;\n}\n.warning-text {\n    background-color: #FFF3E0;\n    padding: 5px;\n    margin-top: 5px;\n    font-size: 9px;\n    border-left: 3px solid #FF9800;\n}\n.brand-line {\n    font-size: 9px;\n    color: #666;\n    margin-top: 4px;\n}\n</style>\n\n<div class=\"label-header\">\n    <h3>PRODUCE BATCH LABEL</h3>\n    <div class=\"brand-line\">Umaish Solutions | 2026 Edition</div>\n</div>\n\n<div class=\"batch-number\">{{ doc.name }}</div>\n\n<div style=\"margin-top: 10px;\">\n    <div class=\"info-row\">\n        <span class=\"info-label\">Item:</span>\n        <span class=\"info-value\"><strong>{{ doc.item }}</strong></span>\n    </div>\n    <div class=\"info-row\">\n        <span class=\"info-label\">Batch No:</span>\n        <span class=\"info-value\">{{ doc.batch_id }}</span>\n    </div>\n    {% if doc.manufacturing_date %}\n    <div class=\"info-row\">\n        <span class=\"info-label\">Harvest Date:</span>\n        <span class=\"info-value\">{{ frappe.utils.formatdate(doc.manufacturing_date, \"dd-MM-yyyy\") }}</span>\n    </div>\n    {% endif %}\n    {% if doc.expiry_date %}\n    <div class=\"info-row\">\n        <span class=\"info-label\">Best Before:</span>\n        <span class=\"info-value\">{{ frappe.utils.formatdate(doc.expiry_date, \"dd-MM-yyyy\") }}</span>\n    </div>\n    {% endif %}\n    <div class=\"info-row\">\n        <span class=\"info-label\">Farm:</span>\n        <span class=\"info-value\">{{ doc.reference_name or \"N/A\" }}</span>\n    </div>\n    <div class=\"info-row\">\n        <span class=\"info-label\">Batch Size:</span>\n        <span class=\"info-value\">{{ doc.batch_qty }} {{ frappe.db.get_value(\"Item\", doc.item, \"stock_uom\") }}</span>\n    </div>\n</div>\n\n{% if doc.description %}\n<div class=\"warning-text\">\n    {{ doc.description }}\n</div>\n{% endif %}\n\n<div class=\"qr-section\">\n    [QR Code]<br/>\n    {{ doc.name }}\n</div>\n\n</div>",
 "idx": 0,
 "line_breaks": 0,
