 "doctype": "Print Format",
 "font_size": 10,
 "html": "<div class=\"print-format\">\n<style>\n.print-format {\n    font-family: Arial, sans-serif;\n    padding: 20px;\n}\n.header {\n    text-align: center;\n    border-bottom: 3px solid #D32F2F;\n    padding-bottom: 10px;\n    margin-bottom: 20px;\n}\n.header h2 {\n    margin: 0;\n    color: #D32F2F;\n}\n.warning {\n    background-color: #FFF3E0;\n    border-left: 4px solid #FF9800;\n    padding: 10px;\n    margin: 15px 0;\n}\n.row {\n    display: flex;\n    margin-bottom: 8px;\n}\n.label {\n    font-weight: bold;\n    width: 250px;\n    color: #555;\n}\n.value {\n    flex: 1;\n}\ntable {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 10px;\n}\ntable th {\n    background-color: #D32F2F;\n    color: white;\n    padding: 10px;\n    text-align: left;\n}\ntable td {\n    padding: 8px;\n    border-bottom: 1px solid #ddd;\n}\n.compliance-note {\n    background-color: #E3F2FD;\n    border: 1px solid #2196F3;\n    padding: 15px;\n    margin-top: 20px;\n}\n</style>\n\n<div class=\"header\">\n    <h2>PESTICIDE APPLICATION RECORD</h2>\n    <p style=\"color: #D32F2F; font-weight: bold;\">SPRAY REGISTER - COMPLIANCE DOCUMENT</p>\n    <p style=\"margin: 6px 0 0; color: #555;\">Umaish Solutions | 2026 Edition</p>\n</div>\n\n<div class=\"warning\">\n    <strong>\u26a0\ufe0f IMPORTANT:</strong> This document must be maintained for regulatory compliance and traceability.\n</div>\n\n<div style=\"margin-bottom: 20px;\">\n    <div class=\"row\">\n        <span class=\"label\">Application Date:</span>\n        <span class=\"value\"><strong>{{ frappe.utils.formatdate(doc.operation_date, \"dd-MM-yyyy\") }}</strong></span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Farm:</span>\n        <span class=\"value\">{{ doc.farm }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Field:</span>\n        <span class=\"value\">{{ doc.field }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Crop:</span>\n        <span class=\"value\">{{ doc.crop_project }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Area Treated:</span>\n        <span class=\"value\">{{ doc.area_covered }} {{ doc.area_uom }}</span>\n    </div>\n</div>\n\n{% if doc.materials_used %}\n<table>\n    <thead>\n        <tr>\n            <th>Chemical/Pesticide</th>\n            <th>Quantity</th>\n            <th>UOM</th>\n            <th>Concentration</th>\n            <th>Purpose</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for row in doc.materials_used %}\n        <tr>\n            <td><strong>{{ row.item }}</strong></td>\n            <td>{{ row.quantity }}</td>\n            <td>{{ row.uom }}</td>\n            <td>{{ row.concentration or \"As per label\" }}</td>\n            <td>{{ row.purpose }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n{% endif %}\n\n<div style=\"margin-top: 20px;\">\n    <div class=\"row\">\n        <span class=\"label\">Application Method:</span>\n        <span class=\"value\">{{ doc.application_method or \"N/A\" }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Operator:</span>\n        <span class=\"value\">{{ doc.operator }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Supervisor:</span>\n        <span class=\"value\">{{ doc.supervisor or \"N/A\" }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Weather Conditions:</span>\n        <span class=\"value\">{{ doc.weather_conditions or \"N/A\" }}</span>\n    </div>\n    {% if doc.pre_harvest_interval_days %}\n    <div class=\"row\">\n        <span class=\"label\" style=\"color: #D32F2F;\">Pre-Harvest Interval (PHI):</span>\n        <span class=\"value\" style=\"color: #D32F2F; font-weight: bold;\">{{ doc.pre_harvest_interval_days }} days</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\" style=\"color: #D32F2F;\">Harvest Permitted After:</span>\n        <span class=\"value\" style=\"color: #D32F2F; font-weight: bold;\">{{ frappe.utils.formatdate(frappe.utils.add_days(doc.operation_date, doc.pre_harvest_interval_days), \"dd-MM-yyyy\") }}</span>\n    </div>\n    {% endif %}\n</div>\n\n<div class=\"compliance-note\">\n    <h4 style=\"margin-top: 0;\">Compliance Notes:</h4>\n    <ul>\n        <li>Operator wore appropriate Personal Protective Equipment (PPE)</li>\n        <li>Application carried out as per product label instructions</li>\n        <li>Pre-Harvest Interval (PHI) to be strictly observed</li>\n        <li>Empty containers disposed as per environmental regulations</li>\n        <li>Buffer zones from water sources maintained</li>\n    </ul>\n\n    <div class=\"row\" style=\"margin-top: 15px;\">\n        <span class=\"label\">Operator Certification:</span>\n        <span class=\"value\">_________________________________</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Date:</span>\n        <span class=\"value\">_________________________________</span>\n    </div>\n</div>\n\n<div style=\"margin-top: 30px; font-size: 9px; color: #666; border-top: 1px solid #ddd; padding-top: 10px;\">\n    <p><strong>Document Reference:</strong> {{ doc.name }} | <strong>Generated:</strong> {{ frappe.utils.format_datetime(frappe.utils.now(), \"dd-MM-yyyy HH:mm\") }} | <strong>Brand:</strong> Umaish Solutions Agriculture 2026</p>\n</div>\n\n</div>",
