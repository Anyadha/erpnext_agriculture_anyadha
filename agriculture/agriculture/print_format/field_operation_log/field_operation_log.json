{
 "align_labels_right": 0,
 "creation": "2024-03-23 12:00:00.000000",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Field Operation Log",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 10,
 "html": "<div class=\"print-format\">\n<style>\n.print-format {\n    font-family: Arial, sans-serif;\n    padding: 20px;\n}\n.header {\n    text-align: center;\n    border-bottom: 2px solid #333;\n    padding-bottom: 10px;\n    margin-bottom: 20px;\n}\n.header h2 {\n    margin: 0;\n    color: #1976D2;\n}\n.section {\n    margin-bottom: 15px;\n}\n.row {\n    display: flex;\n    margin-bottom: 8px;\n}\n.label {\n    font-weight: bold;\n    width: 200px;\n    color: #555;\n}\n.value {\n    flex: 1;\n}\n.observations {\n    background-color: #f5f5f5;\n    padding: 15px;\n    border-left: 4px solid #1976D2;\n    margin: 15px 0;\n}\n.observations h4 {\n    margin-top: 0;\n    color: #1976D2;\n}\ntable {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 10px;\n}\ntable th {\n    background-color: #1976D2;\n    color: white;\n    padding: 10px;\n    text-align: left;\n}\ntable td {\n    padding: 8px;\n    border-bottom: 1px solid #ddd;\n}\n.footer {\n    margin-top: 30px;\n    border-top: 2px solid #333;\n    padding-top: 10px;\n}\n.signature {\n    display: flex;\n    justify-content: space-between;\n    margin-top: 50px;\n}\n.signature-box {\n    text-align: center;\n    width: 200px;\n}\n.signature-line {\n    border-top: 1px solid #333;\n    margin-top: 40px;\n    padding-top: 5px;\n}\n.brand-line {\n    margin-top: 12px;\n    font-size: 9px;\n    color: #666;\n}\n</style>\n\n<div class=\"header\">\n    <h2>FIELD OPERATION LOG</h2>\n    <p style=\"margin: 6px 0 0; color: #555;\">Umaish Solutions | 2026 Edition</p>\n    <p>{{ doc.name }}</p>\n</div>\n\n<div class=\"section\">\n    <div class=\"row\">\n        <span class=\"label\">Date:</span>\n        <span class=\"value\">{{ frappe.utils.formatdate(doc.operation_date, \"dd-MM-yyyy\") }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Operation Type:</span>\n        <span class=\"value\"><strong>{{ doc.operation_type }}</strong></span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Farm:</span>\n        <span class=\"value\">{{ doc.farm }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Field:</span>\n        <span class=\"value\">{{ doc.field }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Crop Project:</span>\n        <span class=\"value\">{{ doc.crop_project or \"N/A\" }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Area Covered:</span>\n        <span class=\"value\">{{ doc.area_covered or \"Full Field\" }} {{ doc.area_uom or \"\" }}</span>\n    </div>\n</div>\n\n<div class=\"section\">\n    <h3>Personnel</h3>\n    <div class=\"row\">\n        <span class=\"label\">Operator:</span>\n        <span class=\"value\">{{ doc.operator }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Supervisor:</span>\n        <span class=\"value\">{{ doc.supervisor or \"N/A\" }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Status:</span>\n        <span class=\"value\">{{ doc.status }}</span>\n    </div>\n</div>\n\n<div class=\"section\">\n    <h3>Activity Description</h3>\n    <p>{{ doc.activity_description }}</p>\n</div>\n\n{% if doc.materials_used %}\n<div class=\"section\">\n    <h3>Materials Used</h3>\n    <table>\n        <thead>\n            <tr>\n                <th>Item</th>\n                <th>Quantity</th>\n                <th>UOM</th>\n                <th>Purpose</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.materials_used %}\n            <tr>\n                <td>{{ row.item }}</td>\n                <td>{{ row.quantity }}</td>\n                <td>{{ row.uom }}</td>\n                <td>{{ row.purpose }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n</div>\n{% endif %}\n\n{% if doc.equipment_used %}\n<div class=\"section\">\n    <h3>Equipment Used</h3>\n    <table>\n        <thead>\n            <tr>\n                <th>Equipment</th>\n                <th>Hours</th>\n                <th>Operator</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.equipment_used %}\n            <tr>\n                <td>{{ row.equipment }}</td>\n                <td>{{ row.hours }}</td>\n                <td>{{ row.operator }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n</div>\n{% endif %}\n\n<div class=\"observations\">\n    <h4>Agronomic Observations</h4>\n\n    {% if doc.pest_observation %}\n    <div class=\"row\">\n        <span class=\"label\">Pests:</span>\n        <span class=\"value\">{{ doc.pest_observation }}</span>\n    </div>\n    {% endif %}\n\n    {% if doc.disease_observation %}\n    <div class=\"row\">\n        <span class=\"label\">Diseases:</span>\n        <span class=\"value\">{{ doc.disease_observation }}</span>\n    </div>\n    {% endif %}\n\n    {% if doc.weed_observation %}\n    <div class=\"row\">\n        <span class=\"label\">Weeds:</span>\n        <span class=\"value\">{{ doc.weed_observation }}</span>\n    </div>\n    {% endif %}\n\n    {% if doc.nutrient_deficiency_observation %}\n    <div class=\"row\">\n        <span class=\"label\">Nutrient Status:</span>\n        <span class=\"value\">{{ doc.nutrient_deficiency_observation }}</span>\n    </div>\n    {% endif %}\n\n    {% if doc.growth_stage_observation %}\n    <div class=\"row\">\n        <span class=\"label\">Growth Stage:</span>\n        <span class=\"value\">{{ doc.growth_stage_observation }}</span>\n    </div>\n    {% endif %}\n\n    {% if doc.weather_conditions %}\n    <div class=\"row\">\n        <span class=\"label\">Weather:</span>\n        <span class=\"value\">{{ doc.weather_conditions }}</span>\n    </div>\n    {% endif %}\n\n    {% if doc.recommended_actions %}\n    <div class=\"row\">\n        <span class=\"label\">Recommended Actions:</span>\n        <span class=\"value\">{{ doc.recommended_actions }}</span>\n    </div>\n    {% endif %}\n</div>\n\n<div class=\"footer\">\n    <div class=\"row\">\n        <span class=\"label\">Recorded By:</span>\n        <span class=\"value\">{{ doc.owner }}</span>\n    </div>\n    <div class=\"row\">\n        <span class=\"label\">Date & Time:</span>\n        <span class=\"value\">{{ frappe.utils.format_datetime(doc.creation, \"dd-MM-yyyy HH:mm\") }}</span>\n    </div>\n\n    <div class=\"signature\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Operator Signature</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Supervisor Signature</div>\n        </div>\n    </div>\n\n    <div class=\"brand-line\">Umaish Solutions Agriculture 2026</div>\n</div>\n\n</div>",
 "idx": 0,
 "line_breaks": 0,
